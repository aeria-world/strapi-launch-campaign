{
  "kind": "collectionType",
  "collectionName": "gifts",
  "info": {
    "singularName": "gift",
    "pluralName": "gifts",
    "displayName": "Gift"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "totalQuantity": {
      "type": "biginteger",
      "required": false,
      "min": "0"
    },
    "remainingQuantity": {
      "type": "biginteger",
      "required": false,
      "min": "0"
    },
    "probability": {
      "type": "biginteger",
      "required": false,
      "unique": false,
      "min": "1"
    },
    "contest_enrollments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contest-enrollment.contest-enrollment",
      "mappedBy": "gift"
    },
    "worth": {
      "type": "decimal",
      "required": true
    },
    "contest": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contest.contest",
      "inversedBy": "gifts"
    }
  }
}
