{
  "kind": "collectionType",
  "collectionName": "prizes",
  "info": {
    "singularName": "prize",
    "pluralName": "prizes",
    "displayName": "Prize"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "totalQuantity": {
      "type": "biginteger",
      "required": true,
