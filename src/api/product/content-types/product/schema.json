{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "totalQuantity": {
      "type": "biginteger",
      "required": true
    },
    "remainingQuantity": {
      "type": "biginteger",
      "required": true
    },
    "worth": {
      "type": "biginteger",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "gifts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gift.gift",
      "mappedBy": "product"
    }
  }
}
