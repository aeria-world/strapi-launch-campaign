{
  "kind": "collectionType",
  "collectionName": "gift_allocations",
  "info": {
    "singularName": "gift-allocation",
    "pluralName": "gift-allocations",
    "displayName": "gift allocation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "gift": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gift.gift"
    },
    "allocatedAt": {
      "type": "datetime",
      "required": true,
      "default": "now"
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "allocated",
      "enum": [
        "allocated",
        "claimed",
        "expired"
      ]
    },
    "claimedAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "contest": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contest.contest"
    }
  }
}
